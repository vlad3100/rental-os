# Copy to .env and adjust. Never commit .env.

# Only "synthetic" is supported in v0.1. Real pilot data needs the readiness review first.
RC_DATA_MODE=synthetic

# "mock" (deterministic, no API key, default) or "anthropic" (needs ANTHROPIC_API_KEY and the claude extra)
RC_LLM_PROVIDER=mock

# Only needed when RC_LLM_PROVIDER=anthropic.
# The SDK also finds credentials from `ant auth login`, so the key can stay empty if you use that.
ANTHROPIC_API_KEY=
RC_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 default is medium; set explicitly)
RC_ANTHROPIC_EFFORT=medium

# SQLite database file (created on first run)
RC_DB_PATH=var/rental_copilot.db

# Classifications below this confidence go to human review
RC_CONFIDENCE_THRESHOLD=0.6
